# ============================================================================
# PulseChain stack configuration
# Copy to .env (setup.sh does this for you) and adjust.
# ============================================================================

# ----------------------------------------------------------------------------
# Network — exactly ONE block active. Default: mainnet.
# ----------------------------------------------------------------------------
EL_NETWORK_FLAG=--pulsechain
CL_NETWORK=pulsechain
CHECKPOINT_URL=https://checkpoint.pulsechain.com

# Testnet v4 (uncomment these three, comment out the mainnet block above):
# EL_NETWORK_FLAG=--pulsechain-testnet-v4
# CL_NETWORK=pulsechain_testnet_v4
# CHECKPOINT_URL=https://checkpoint.v4.testnet.pulsechain.com

# ----------------------------------------------------------------------------
# Which optional services to run alongside the base node (comma-separated).
# Base node (execution + consensus) always runs.
#   validator   — lighthouse validator client (needs imported keys)
#   rpc         — nginx rate-limited RPC edge for serving others
#   monitoring  — prometheus + grafana
# ----------------------------------------------------------------------------
COMPOSE_PROFILES=
# COMPOSE_PROFILES=validator
# COMPOSE_PROFILES=validator,rpc,monitoring

# ----------------------------------------------------------------------------
# Validator — REQUIRED before enabling the validator profile.
# FEE_RECIPIENT: your wallet address; priority fees from proposed blocks go here.
# Leaving it empty makes the validator client refuse to start (by design —
# better than silently burning rewards).
# ----------------------------------------------------------------------------
FEE_RECIPIENT=
GRAFFITI=

# ----------------------------------------------------------------------------
# RPC exposure
# RPC_BIND_ADDR: which host interface ports 8545/8546/5052 bind to.
#   127.0.0.1 = local only (safe default). 0.0.0.0 = all interfaces (only
#   behind a firewall, or use the rpc profile's nginx edge instead).
# ----------------------------------------------------------------------------
RPC_BIND_ADDR=127.0.0.1
RPC_PROXY_HTTP_PORT=8080
HTTP_APIS=eth,net,web3,txpool
WS_APIS=eth,net,web3
HTTP_CORS=*
WS_ORIGINS=*

# ----------------------------------------------------------------------------
# Performance / images
# Pin image tags for production stability if you prefer, e.g.:
#   EL_IMAGE=registry.gitlab.com/pulsechaincom/go-pulse:v1.0.0
# ----------------------------------------------------------------------------
EL_MAX_PEERS=50
EL_IMAGE=registry.gitlab.com/pulsechaincom/go-pulse:latest
CL_IMAGE=registry.gitlab.com/pulsechaincom/lighthouse-pulse:latest

# ----------------------------------------------------------------------------
# Monitoring
# ----------------------------------------------------------------------------
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme
GRAFANA_BIND_ADDR=127.0.0.1
